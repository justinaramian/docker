{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Los_Angeles",
  "schedule": ["at any time"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "packageRules": [
    {
      "description": "Databases: majors need a data migration, handle manually",
      "matchPackageNames": ["/postgres/", "/redis/", "/mariadb/", "/mysql/", "/valkey/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "LinuxServer.io images use a non-semver tag format",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^(gh|ls)cr\\.io\\/linuxserver\\//"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-ls(?<revision>\\d+)$"
    },
    {
      "description": "13ft publishes 1.x image tags that are older than its 0.4.x releases",
      "matchPackageNames": ["ghcr.io/wasi-master/13ft"],
      "allowedVersions": "<1.0.0"
    },
    {
      "description": "SparkyFitness frontend and server share a version",
      "matchPackageNames": ["/^codewithcj\\/sparkyfitness/"],
      "groupName": "sparkyfitness"
    },
    {
      "description": "Immich server and machine-learning must move together",
      "matchPackageNames": ["/^ghcr\\.io\\/immich-app\\/immich-/"],
      "groupName": "immich"
    },
    {
      "description": "Authentik server and worker share an image and version",
      "matchPackageNames": ["/^ghcr\\.io\\/goauthentik\\//"],
      "groupName": "authentik"
    },
    {
      "description": "phpIPAM www and cron share a version",
      "matchPackageNames": ["/^phpipam\\/phpipam-/"],
      "groupName": "phpipam"
    },
    {
      "description": "Low-impact services: automerge all update types",
      "matchFileNames": [
        "sear-xng/**",
        "nebula-sync/**",
        "homarr/**",
        "freshrss/**",
        "dozzle/**",
        "dockerproxy/**",
        "cloudflare-ddns/**",
        "stirling-pdf/**",
        "so-crates/**",
        "it-tools/**"
      ],
      "automerge": true
    },
    {
      "description": "Renovate itself: automerge minor and patch, majors need review",
      "matchPackageNames": ["renovate/renovate", "ghcr.io/renovatebot/renovate"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    }
  ]
}