{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Los_Angeles",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "packageRules": [
    {
      "description": "Databases: majors need a data migration, handle manually",
      "matchPackageNames": ["/postgres/", "/redis/", "/mariadb/", "/mysql/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}